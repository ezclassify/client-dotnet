{
  "metadata": [{
    "src": [{
      "src": "..",
      "files": [
        "EzClassify.Rest.Contract/EzClassify.Rest.Contract.csproj",
        "EzClassify.Rest.Client/EzClassify.Rest.Client.csproj"
      ]
    }],
    "dest": "api",
    "properties": {"TargetFramework": "netstandard2.0"}
  }],
  "build": {
